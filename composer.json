{
    "name": "celyes/ralph-php",
    "description": "A Ralph-style development loop for PHP: reads tasks from a Markdown checklist, delegates them to a coding agent, verifies the result, and commits the work.",
    "type": "library",
    "keywords": [
        "ralph",
        "agent",
        "automation",
        "cli",
        "codex",
        "claude",
        "developer-tools"
    ],
    "homepage": "https://github.com/celyes/ralph-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Ilyes Chouia",
            "email": "celyes02@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/celyes/ralph-php/issues",
        "source": "https://github.com/celyes/ralph-php"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "autoload": {
        "psr-4": {
            "Celyes\\RalphPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Celyes\\RalphPhp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ralph"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "test": "Run the automated test suite."
    }
}
