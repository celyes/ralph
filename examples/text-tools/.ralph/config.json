{
    "tasks": ".ralph/tasks.md",
    "context": ".ralph/CONTEXT.md",
    "agent": "codex",
    "agents": {
        "codex": {
            "adapter": "codex",
            "executable": "codex",
            "model": null,
            "arguments": [],
            "environment": []
        },
        "claude": {
            "adapter": "claude",
            "executable": "claude",
            "model": null,
            "arguments": [],
            "environment": []
        }
    },
    "checks": [
        {
            "name": "tests",
            "command": [
                "composer",
                "test"
            ],
            "timeout": 300
        }
    ],
    "limits": {
        "iterations": 3,
        "attempts_per_task": 2,
        "task_timeout": 1200,
        "run_timeout": 3600,
        "bail_on_failure": false
    },
    "logs": {
        "wipe_on_success": false
    }
}
